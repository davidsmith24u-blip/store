# Server
NODE_ENV=development
PORT=3000

# Required: clients must send this value in the x-api-key header
# (or as "Authorization: Bearer <key>"). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=replace-with-a-long-random-secret

# Comma-separated list of allowed browser origins, or * for any origin
CORS_ORIGIN=*
# Set to 1 when running behind a single reverse proxy (nginx, Render, Fly, etc.)
TRUST_PROXY=0

# Request throttling
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Maximum recipients accepted by the bulk endpoints
MAX_BULK_RECIPIENTS=100

# Twilio (omit to disable the SMS endpoints; they return 503)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid (omit to disable the email endpoints; they return 503)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
